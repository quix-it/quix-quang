{
  "name": "quang",
  "author": "Quix Srl",
  "homepage": "https://quix-it.github.io/quix-quang/",
  "version": "21.2.1",
  "scripts": {
    "prepare": "husky",
    "ng": "ng",
    "copy-readme": "node scripts/copy-readme.js",
    "start:playground": "npm run copy-readme && ng serve playground",
    "build:playground": "npm run copy-readme && ng build playground",
    "build:quang": "ng build --project quang",
    "build-publish": "npm run build:quang && node scripts/npm-publish.js",
    "build-publish:prerelease": "npm run build:quang && cd dist/quang && npm publish --tag prerelease",
    "sync-version": "jq '.version = \"'$npm_package_version'\"' projects/quang/package.json > temp.json && mv temp.json projects/quang/package.json",
    "version": "npm run sync-version && git add -A",
    "postversion": "git push && git push --tags",
    "cleanup": "rm -rf dist && rm -rf .angular && rm -rf node_modules && npm i",
    "publish:prerelease": "npm run cleanup && npm version prerelease -m \"build(prerelease): version %s\" && npm run build-publish:prerelease",
    "publish:patch": "npm run cleanup && npm version patch -m \"build(patch): version %s\" && npm run build-publish && npm run deploy:git",
    "publish:minor": "npm run cleanup && npm version minor -m \"build(minor): version %s\" && npm run build-publish && npm run deploy:git",
    "publish:major": "npm run cleanup && npm version major -m \"build(major): version %s\" && npm run build-publish && npm run deploy:git",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "npx prettier . -w --ignore-unknown",
    "lint-and-format": "npm run lint:fix && npm run format",
    "deploy:git": "npm run copy-readme && ng deploy playground --base-href=/quix-quang/",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:browser": "vitest --config vitest.browser.config.ts"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.0.0",
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-browser-dynamic": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/browser": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@jsverse/transloco": "^7.5.0",
    "@ngrx/signals": "^21.0.1",
    "air-datepicker": "^3.5.0",
    "angular-oauth2-oidc": "^20.0.2",
    "angular-svg-icon": "^19.1.1",
    "bootstrap": "^5.3.3",
    "date-fns": "^3.6.0",
    "prismjs": "^1.29.0",
    "ngx-markdown": "^22.0.0",
    "rxjs": "~7.8.2",
    "suneditor": "^2.46.0",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.1.3",
    "@analogjs/vitest-angular": "^2.1.3",
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@angular/language-service": "^22.0.0",
    "@capacitor/cli": "^7.0.0",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/js": "^9.22.0",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^22.13.10",
    "@types/prismjs": "^1.26.5",
    "@vitest/browser": "^4.0.15",
    "@vitest/browser-playwright": "^4.0.15",
    "@vitest/coverage-v8": "^4.0.15",
    "angular-cli-ghpages": "^2.0.3",
    "angular-eslint": "^22.0.0",
    "eslint": "^9.22.0",
    "eslint-config-love": "^117.0.0",
    "husky": "^9.1.7",
    "jsdom": "^27.2.0",
    "lint-staged": "^15.4.3",
    "ng-lint-staged": "^12.0.4",
    "ng-packagr": "^22.0.0",
    "playwright": "^1.57.0",
    "prettier": "^3.5.3",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.26.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.15"
  },
  "overrides": {
    "@angular/build": {
      "vitest": "^4.0.15"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/quix-it/quix-quang.git"
  }
}
